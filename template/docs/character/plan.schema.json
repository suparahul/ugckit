              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string"
    },
    "approved": {
      "type": "object",
      "required": [
        "words",
        "date"
      ],
      "properties": {
        "words": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      }
    },
    "reaction_refs": {
      "description": "The real reference reactions from the user's research, named by post and range. generation_input motion_copy, the one default of every reaction with a reference (founder, 2026-10-19): production trims the range, masks its burned-in text, and gives that copy to the video model with the character's approved first frame; the clip gives the motion and the timing (an X segment). A visible face is not required. written: the written expression beats only, with no clip; only the user names it, after a failed motion take, and written_reason holds the user's words. A missing or null generation_input is motion_copy. The names before 2026-10-19 are read and never rewritten: face_replace is motion_copy, none and false are written. The research file itself is never attached to a generation.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "post_id",
          "platform",
          "handle",
          "post_dir",
          "video_path",
          "video_sha256",
          "start_s",
          "end_s",
          "notes_ref",
          "generation_input"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "post_id": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "handle": {
            "type": [
              "string",
              "null"
            ]
          },
          "post_dir": {
            "type": "string"
          },
          "video_path": {
            "type": "string"
          },
          "video_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "required for motion_copy"
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "notes_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "generation_input": {
            "enum": [
              "motion_copy",
              "written",
              "face_replace",
              "none",
              null,
              false
            ],
            "description": "motion_copy (the default) or written (the user's fallback after a failed motion take). face_replace, none, null and false: the names before 2026-10-19, still read"
          },
          "written_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "with generation_input written: the user's words that name the written fallback after a failed motion take; required then"
          },
          "burned_in_text": {
            "type": [
              "string",
              "null"
            ],
            "description": "the visible text in the range and where it is, or null when clean; production masks it"
          },
          "permission_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "optional; never required (founder, 2026-10-04)"
          },
          "library_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "the reaction library entry this reference copies (library/reactions/reactions.json, scripts/planning/reactions.py), or null for a research post not in the library"
          },
          "library_differs": {
            "type": [
              "string",
              "null"
            ],
            "description": "why the range is not the library entry's range; null when it is"
          }
        }
      }
    }
  }
