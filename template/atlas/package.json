  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "three": "0.149.0",
    "typescript": "^5.6.0"
  }
}
