# Copy to .env and fill in. .env is gitignored; never commit it, never paste the key
# into a chat, and never let an agent print it.
#
# IMPORTANT: keep each variable on its own line with a trailing newline. Appending with
# `echo VAR=x >> .env` when the previous line has no newline welds two variables together
# and the symptom is a confusing 401. scripts/doctor.py checks for this.

# Shown during Supagen onboarding, or: dashboard left menu -> Developer -> API keys.
SUPAGEN_API_KEY=
SUPAGEN_WORKSPACE_ID=

# Research phase only (stages R1-R5). Get a key at https://app.monid.ai/access/api-keys — Keys, then
# copy it here. It looks like monid_<stage>_<secret>. The scripts drive the monid CLI,
# which keeps its own credential store, so store it there too, once:
#   ./ugckit key            (it registers the key with the CLI for you)
# Leave this blank if you are starting from a reference video you already have.
MONID_API_KEY=

# The research-led script path (the `originate` skill) only. Points at a research
# corpus checkout containing library/hooks.jsonl and media/<app>/TEARDOWN.md.
LIBRARY_DIR=
