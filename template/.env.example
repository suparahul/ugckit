# Copy to .env and fill in. .env is gitignored; never commit it, never paste the key
# into a chat, and never let an agent print it.
#
# IMPORTANT: keep each variable on its own line with a trailing newline. Appending with
# `echo VAR=x >> .env` when the previous line has no newline welds two variables together
# and the symptom is a confusing 401. scripts/doctor.py checks for this.

SUPAGEN_API_KEY=
SUPAGEN_WORKSPACE_ID=
