{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ugckit/docs/character/plan.schema.json",
  "title": "The locked plan of a character video, v2",
  "description": "pipeline/character/<video>/plan.json. A plan without schema_version is a legacy (v1) plan and is not described here: it keeps the fields of the v1 example and runs as before. This schema is the shape; scripts/character/bridge.py checks the shape and the rules a schema cannot say: beats in order with no gap that cover format.length_s, at most 15 words per 4 s, each line in one beat, voiceover beats bound to a narrator, an original synthetic narrator never over a human face, a real subject never generated, panel ranges inside the approved asset range, split-screen panels that do not overlap, overlays long enough to read (words / 3 s, 1 s at least) that are never a hero string, a source credit while a licensed or permitted clip is on screen, a day counter that is the series day, the live pairing of an input clip and its app recording, and planning-approval.json matching the digest of this exact content.",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "video_id",
    "app",
    "handle",
    "characters",
    "format",
    "app_insertion",
    "editorial",
    "script",
    "beats",
    "overlays",
    "assets",
    "narrators",
    "approved"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "video_id": {
      "type": "string"
    },
    "app": {
      "type": "string"
    },
    "handle": {
      "type": "string"
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*@v[0-9]+$"
      }
    },
    "format": {
      "type": "object",
      "required": [
        "dimension",
        "length_s"
      ],
      "properties": {
        "dimension": {
          "const": "9:16"
        },
        "length_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "app_insertion": {
      "type": "boolean"
    },
    "editorial": {
      "type": "object",
      "required": [
        "objective",
        "distribution",
        "lane",
        "filming_format",
        "hook",
        "recipe_id",
        "product",
        "app_presence",
        "proof",
        "close",
        "cast_kind"
      ],
      "properties": {
        "objective": {
          "enum": [
            "product_action",
            "product_discovery",
            "reach",
            "save_share"
          ]
        },
        "distribution": {
          "enum": [
            "organic",
            "paid"
          ]
        },
        "lane": {
          "enum": [
            "discovery",
            "education",
            "everyday",
            "pitch"
          ]
        },
        "filming_format": {
          "enum": [
            "before_after",
            "face_to_demo",
            "hook_to_demo",
            "live_use",
            "talking_head",
            "text_over_action",
            "voiceover_action"
          ]
        },
        "recipe_id": {
          "enum": [
            "discovery_demo",
            "explain_action",
            "list_steps",
            "personal_note",
            "pitch_proof",
            "routine_log",
            "setup_reveal",
            "state_change"
          ]
        },
        "app_presence": {
          "enum": [
            "demonstration",
            "incidental_use",
            "none",
            "result"
          ]
        },
        "close": {
          "enum": [
            "follow",
            "none",
            "payoff",
            "product_action",
            "profile",
            "question",
            "save",
            "share"
          ]
        },
        "cast_kind": {
          "enum": [
            "human",
            "mascot",
            "none"
          ]
        },
        "hook": {
          "type": "object",
          "required": [
            "job_id",
            "channel"
          ],
          "properties": {
            "job_id": {
              "enum": [
                "category_analogy",
                "confession_reframe",
                "discovery_regret",
                "explanation",
                "gratitude_discovery",
                "imminent_need",
                "in_progress",
                "peer_question",
                "quoted_challenge",
                "specific_promise",
                "visible_result",
                "withheld_reveal"
              ]
            },
            "channel": {
              "enum": [
                "reaction",
                "spoken",
                "spoken_visual",
                "text",
                "text_visual",
                "visual"
              ]
            },
            "framing": {
              "type": "array",
              "items": {
                "enum": [
                  "audience_callout",
                  "count",
                  "lived_experience",
                  "negative",
                  "professional_basis"
                ]
              }
            }
          }
        },
        "product": {
          "type": "object",
          "properties": {
            "role": {
              "enum": [
                "absent",
                "incidental_tool",
                "main_subject",
                "story_solution"
              ]
            },
            "name_locations": {
              "type": "array",
              "items": {
                "enum": [
                  "bio",
                  "caption",
                  "overlay",
                  "speech"
                ]
              }
            },
            "speech_count": {
              "type": "integer",
              "minimum": 0
            },
            "timing": {
              "enum": [
                "absent",
                "closing",
                "middle",
                "opening",
                "throughout"
              ]
            }
          }
        },
        "proof": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "none",
                "real_screen_result",
                "sourced_fact",
                "visible_action"
              ]
            },
            "fact_refs": {
              "type": "array"
            }
          }
        },
        "narrator_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "series": {
          "anyOf": [
            {
              "const": "standalone"
            },
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "series_id",
                "subject_ids",
                "routine_id",
                "episode",
                "day",
                "state_fact_refs"
              ],
              "properties": {
                "kind": {
                  "const": "progress_log"
                },
                "episode": {
                  "type": "integer",
                  "minimum": 1
                },
                "day": {
                  "type": "integer",
                  "minimum": 0
                },
                "previous_plan_ref": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        },
        "comparison_mode": {
          "anyOf": [
            {
              "enum": [
                "before_after",
                "best_worst",
                "wrong_right"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "experiment": {
          "type": "object",
          "properties": {
            "axis": {
              "enum": [
                "cast",
                "close",
                "hook",
                "none",
                "product_presence",
                "proof"
              ]
            },
            "base_video_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "strategy_ref": {
          "description": "The row of the user's strategy this video executes, copied from the brief: {file, section, row (verbatim), disposition}. A plain string (early drafts) is still read, with a note.",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "file",
                "section",
                "row",
                "disposition"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "section": {
                  "type": "string"
                },
                "row": {
                  "type": "string"
                },
                "disposition": {
                  "enum": [
                    "avoid",
                    "candidate",
                    "scheduled",
                    "stopped"
                  ]
                }
              }
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "script": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "speaker",
          "line"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "speaker": {
            "type": "string"
          },
          "line": {
            "type": "string"
          },
          "delivery": {
            "type": "string"
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "start_s",
          "end_s",
          "lines",
          "action",
          "performance",
          "framing"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "action": {
            "type": "string"
          },
          "fact_refs": {
            "type": "array"
          },
          "performance": {
            "enum": [
              "on_camera",
              "silent_action",
              "voiceover"
            ]
          },
          "narrator_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "set_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "framing": {
            "enum": [
              "app_screen",
              "face",
              "hands_only",
              "subject_only"
            ],
            "description": "Who or what fills the frame. app_screen: the real app full frame (an R or P segment: a real recording, a real still or motion design, demo_source), app_on_screen true, layout sequence."
          },
          "layout": {
            "enum": [
              "picture_in_picture",
              "sequence",
              "split_screen"
            ]
          },
          "media_origin": {
            "enum": [
              "generated",
              "mixed",
              "supplied"
            ]
          },
          "panels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "rect"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "asset_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source_range_s": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "rect": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "crop": {
                  "enum": [
                    "cover",
                    "pad"
                  ]
                },
                "sync_offset_s": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "repeat_group": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "item_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "app_on_screen": {
            "type": "boolean"
          },
          "screen_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "demo_source": {
            "description": "Which picture of the app a full-screen app beat shows (founder, 2026-10-19; scripts/character/demo.py): recording (a real screen recording of the screen library), still (a real still of the library, held) or motion_design (the app's real screens rebuilt in code from PRODUCT-SCREENS.md and the app's own code and in-app text, animated and rendered locally at 1080x1920 by motion_design.py; never a video model). Absent: the library row's kind. A real recording is preferred; motion design only on framing app_screen, with demo_source_reason and screen_story.",
            "anyOf": [
              {
                "enum": [
                  "recording",
                  "still",
                  "motion_design"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "demo_source_reason": {
            "description": "Why this demo source: required for motion_design (why no real recording shows this screen).",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "screen_story": {
            "description": "motion_design only: what the rendered screen shows, and nothing else. screens: headings of apps/<slug>/PRODUCT-SCREENS.md, exactly; rebuilt_from: the app's code paths or screenshots; steps: at_s (seconds from the beat's start, the first at 0), the screen, the action, its target, and every in-app string visible at that step, word for word; fit pad (the default: the whole screen at the frame's height) or crop.",
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "screens",
                  "rebuilt_from",
                  "steps"
                ],
                "properties": {
                  "screens": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "rebuilt_from": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "steps": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "at_s",
                        "screen",
                        "action",
                        "shows"
                      ],
                      "properties": {
                        "at_s": {
                          "type": "number",
                          "minimum": 0
                        },
                        "screen": {
                          "type": "string"
                        },
                        "action": {
                          "enum": [
                            "appear",
                            "tap",
                            "scroll",
                            "swipe",
                            "type",
                            "result",
                            "hold"
                          ]
                        },
                        "target": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "shows": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "fit": {
                    "enum": [
                      "pad",
                      "crop"
                    ]
                  }
                }
              }
            ]
          },
          "viewer_must": {
            "anyOf": [
              {
                "enum": [
                  "believe",
                  "read",
                  "recognise"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "reaction": {
            "description": "A silent reaction (segment X) from a real reference reaction: by motion copy, the one default (founder, 2026-10-19), the handle's approved character in a first frame made from the clip's is moved by the trimmed reference clip, and the written expression beats are the review checklist; by the written fallback (generation_input written) the character performs the expression beats with no clip. No line, no voice, no lip sync. null while no reference is found (production waits). Founder, 2026-10-03: a reaction hook is never spoken.",
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "ref_id",
                  "framing",
                  "camera_distance",
                  "expression_beats"
                ],
                "properties": {
                  "ref_id": {
                    "type": "string"
                  },
                  "framing": {
                    "type": "string"
                  },
                  "camera_distance": {
                    "type": "string"
                  },
                  "expression_beats": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "start_s",
                        "end_s",
                        "ref_s",
                        "face",
                        "eyes",
                        "head"
                      ],
                      "properties": {
                        "start_s": {
                          "type": "number",
                          "minimum": 0
                        },
                        "end_s": {
                          "type": "number",
                          "minimum": 0
                        },
                        "ref_s": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "face": {
                          "type": "string"
                        },
                        "eyes": {
                          "type": "string"
                        },
                        "head": {
                          "type": "string"
                        },
                        "hands": {
                          "type": "string",
                          "description": "optional: what the hands do"
                        }
                      }
                    }
                  },
                  "camera": {
                    "type": "string",
                    "description": "optional: the camera of the reference (handheld, locked off)"
                  }
                }
              }
            ]
          },
          "continues_previous": {
            "type": "boolean",
            "description": "Optional. true: this beat's picture continues the previous beat's in one take, across the join (a beat longer than one clip, or one movement over two beats). Production seeds this beat's first clip with the last frame of the previous beat's clip (scripts/character/continuity.py) and cuts the two without a repeated frame. Both beats are generated (no source asset, layout sequence, not the app, not a motion-copy reaction) in the same set. Absent or false: an ordinary cut."
          }
        }
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "text",
          "start_s",
          "end_s",
          "placement"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "comparison_label",
              "day_counter",
              "hook",
              "paragraph",
              "source_credit",
              "step_label"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "placement": {
            "enum": [
              "middle",
              "panel",
              "top",
              "upper_left",
              "upper_right"
            ]
          },
          "panel_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "fact_refs": {
            "description": "The facts (brief facts ids) an overlay states. Required when the text has a digit, except step_label and day_counter.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "origin",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "audio",
              "clip",
              "screen",
              "still"
            ]
          },
          "origin": {
            "enum": [
              "app_recording",
              "licensed",
              "own_camera",
              "permitted_reference",
              "user_supplied",
              "verified_expert"
            ]
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "permission_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "set_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "trim_s": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "null"
              }
            ]
          },
          "screen_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "paired_input_ref": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "asset_id",
                  "input_t_s",
                  "output_t_s"
                ],
                "properties": {
                  "asset_id": {
                    "type": "string"
                  },
                  "input_t_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "output_t_s": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "narrators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "character",
              "original_synthetic",
              "supplied_speaker"
            ]
          },
          "character_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "voice_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "credential_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "set": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "outfit": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "hero_strings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "publishing_note": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "caption": {
              "anyOf": [
