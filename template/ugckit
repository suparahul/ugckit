#!/usr/bin/env bash
# ugckit — project-local command dispatcher.
set -euo pipefail
PROJ="$(cd "$(dirname "$0")" && pwd)"
PY="$PROJ/.venv/bin/python3"
[ -x "$PY" ] || PY=python3

case "${1:-help}" in
  doctor)   shift; exec "$PY" "$PROJ/scripts/doctor.py" "$@" ;;
  ui)       shift; exec "$PY" "$PROJ/scripts/ui.py" "$@" ;;
  key)      shift; exec "$PY" "$PROJ/scripts/setkey.py" "$@" ;;
  workspace) shift; exec "$PY" "$PROJ/scripts/setkey.py" --workspace "$@" ;;
  state)    shift; exec "$PY" "$PROJ/scripts/state.py" "$@" ;;
  qc)       shift; exec "$PY" "$PROJ/scripts/qc.py" "$@" ;;
  library)  shift; exec "$PY" "$PROJ/scripts/library.py" "$@" ;;
  atlas)    shift; exec "$PROJ/scripts/atlas.sh" "$@" ;;
  apps)     shift; exec "$PROJ/scripts/apps.sh" "$@" ;;
  network)  shift; exec "$PROJ/scripts/network.sh" "$@" ;;
  harvest)  shift; exec "$PROJ/scripts/harvest.sh" "$@" ;;
  deepen)   shift; exec "$PROJ/scripts/deepen.sh" "$@" ;;
  handoff)  shift; exec "$PROJ/scripts/handoff.sh" "$@" ;;
  ingest)   shift; exec "$PROJ/scripts/ingest.sh" "$@" ;;
  watch)    shift; exec "$PROJ/scripts/watch.sh" "$@" ;;
  transcribe) shift; exec "$PROJ/scripts/transcribe.sh" "$@" ;;
  generate) shift; exec "$PROJ/scripts/generate.sh" "$@" ;;
  composite) shift; exec "$PROJ/scripts/composite.sh" "$@" ;;
  product-facts) shift; exec "$PROJ/scripts/product-facts.sh" "$@" ;;
  niche-search) shift; exec "$PROJ/scripts/niche-search.sh" "$@" ;;
  niche-import) shift; exec "$PROJ/scripts/niche-import.sh" "$@" ;;
  niche-fetch) shift; exec "$PROJ/scripts/niche-fetch.sh" "$@" ;;
  niche-stats) shift; exec "$PY" "$PROJ/scripts/niche-stats.py" "$@" ;;
  hashtag-pool) shift; exec "$PROJ/scripts/hashtag-pool.sh" "$@" ;;
  images)   shift; exec "$PROJ/scripts/images.sh" "$@" ;;
  codex-images) shift; exec "$PROJ/scripts/codex-images.sh" "$@" ;;
  callout)  shift; exec node "$PROJ/scripts/render-callout.mjs" "$@" ;;
  render)   shift; exec node "$PROJ/scripts/render-slides.mjs" "$@" ;;
  posting-accounts) shift; exec node "$PROJ/scripts/posting-accounts.mjs" "$@" ;;
  post)     shift; exec node "$PROJ/scripts/posting-send.mjs" "$@" ;;
  sync)     shift; exec node "$PROJ/scripts/posting-sync.mjs" "$@" ;;
  update)
    # Get the latest kit and run its installer on this folder. apps/, research/,
    # pipeline/ and .env are never touched; a kit file you changed is merged, not
    # replaced (install.sh says which). UGCKIT_REPO may be a local clone, for a test.
    # The installer rewrites this file while it runs: bash has read the whole case
    # statement already, and the branch ends in exit, so nothing more is read from it.
    shift
    REPO="${UGCKIT_REPO:-https://github.com/suparahul/ugckit}"
    BR="${UGCKIT_BRANCH:-main}"
    while [ $# -gt 0 ]; do
      case "$1" in
        --branch) BR="${2:?--branch needs a name}"; shift 2 ;;
        *) echo "ugckit update: unknown option $1 (use: ugckit update [--branch B])" >&2; exit 2 ;;
      esac
    done
    command -v git >/dev/null 2>&1 || { echo "git is required for ugckit update" >&2; exit 1; }
    echo "installed: $(cat "$PROJ/.ugckit-version" 2>/dev/null || echo unknown)"
    TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
    echo "fetching ugckit from $REPO (branch $BR) ..."
    git clone -q --filter=blob:none --branch "$BR" "$REPO" "$TMP/ugckit" 2>/dev/null \
      || git clone -q --depth 1 --branch "$BR" "$REPO" "$TMP/ugckit" \
      || { echo "could not fetch $REPO (branch $BR)" >&2; exit 1; }
    echo "fetched:   $(cat "$TMP/ugckit/VERSION" 2>/dev/null || echo dev)"
    cd "$PROJ"
    rc=0; UGCKIT_BRANCH="$BR" bash "$TMP/ugckit/install.sh" . || rc=$?
    exit "$rc"
    ;;
  *)
    cat <<'USAGE'
ugckit — a niche or a reference video in, a recreation out.

  ugckit doctor              preflight: tools, deps, credentials, live auth
  ugckit ui [--port N]       local review UI (default http://127.0.0.1:7878)
  ugckit key                 fill in .env — it asks you for each secret
  ugckit key postbridge      the posting service's key, at the first send
  ugckit workspace <id>      the agent sets this from list_workspaces (MCP)
  ugckit update [--branch B] get the latest kit; apps/, research/ and .env stay,
                             and a kit file you changed is merged, not replaced
  ugckit state show <proj>   pipeline progress, spend and open feedback
  ugckit state projects      list projects

  research (R0-R5), optional — costs Monid credit:
  ugckit apps <proj> "<keyword>" ...            find the apps in the niche
  ugckit network <proj> <app> "<keyword>" ...   find who really promotes one app
  ugckit network <proj> <app> --comments <url>  read a post's comments
  ugckit harvest <proj> <app> --all [maxItems]
  ugckit deepen <proj> <app> --rank | --deep | <handle>
  ugckit handoff <proj> <app> <handle> <post-id>
  ugckit library <stats|templates|hooks|formats|mechanics|teardowns>
  ugckit atlas [--index]                        the Organic Factory UI, at http://localhost:3210 (the Atlas is its research part)

  the slideshow path (an app in, two slideshows a day per handle out):
  ugckit product-facts <slug> [--id N | --repo P | --website U | --typed ...]
  ugckit niche-search <slug> "<keyword>" ...     the Photo tab and general search doors (DOORS=...,instagram adds Instagram)
  ugckit niche-import <slug>                     the covers and the niche page from the searches on disk (free)
  ugckit niche-fetch <slug> <date>               the posts you brought, through Monid
  ugckit niche-stats <slug> <date>               the counting parts of the read
  ugckit hashtag-pool <slug> "#tag" ...          measure a hashtag pool, $0.0015 a tag
  ugckit images <slug> <post> | ugckit codex-images <slug> <post>   the pictures
  ugckit callout <slug> <post> [--template appstore|feature|custom]
  ugckit render <slug> <post>                    the finished slides
  ugckit posting-accounts <slug>                 map handles to the posting service
  ugckit post <slug> --post <key> [--send]       send to every platform of the handle (dry run without --send;
                                                 --only tiktok|instagram for one)
  ugckit sync <slug> --all | --date D | --post <key>

  recreation (1-9):
  ugckit ingest <video> <proj> [start] [len]
  ugckit watch <proj>
  ugckit transcribe <proj>
  ugckit generate <proj>     (needs CONFIRM=1 — it spends money)
  ugckit qc <proj>
  ugckit composite <proj>

Most of the time you should not run these by hand. Start an agent in this
directory and let it drive:  claude   (or: codex)
It reads AGENTS.md and runs the stages in order.
USAGE
    ;;
esac
