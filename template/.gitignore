.env
.venv/
__pycache__/
*.pyc

# Generated media is large and reproducible from the prompt. Keep the prompts, the
# breakdowns and the state; leave the renders out of git.
pipeline/00-source/*/
pipeline/06-generated/*/*.mp4
pipeline/07-composite/*/
!pipeline/*/.gitkeep

# Scraped media is large and re-buyable; the analysis written from it is neither.
# Keep NOTES.md, TEARDOWN.md, the tsv tables and the hook banks. Leave the rest out.
research/*/searches/
research/*/*/searches/
research/*/*/comments/
research/*/*/*/covers/
research/*/*/*/*/
research/*/*/*/posts.json
research/.monid.lock/
research/*/*/logo.jpg

# The Atlas: installed and generated on first run of `ugckit atlas`.
atlas/node_modules/
atlas/.next/
atlas/next-env.d.ts
atlas/data/index.json
atlas/public/search.json
atlas/tsconfig.tsbuildinfo
*.bak
