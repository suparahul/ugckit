#!/usr/bin/env bash
# ugckit — project-local command dispatcher.
set -euo pipefail
PROJ="$(cd "$(dirname "$0")" && pwd)"
PY="$PROJ/.venv/bin/python3"
[ -x "$PY" ] || PY=python3

case "${1:-help}" in
  doctor)   shift; exec "$PY" "$PROJ/scripts/doctor.py" "$@" ;;
  ui)       shift; exec "$PY" "$PROJ/scripts/ui.py" "$@" ;;
  key)      shift; exec "$PY" "$PROJ/scripts/setkey.py" "$@" ;;
  state)    shift; exec "$PY" "$PROJ/scripts/state.py" "$@" ;;
  qc)       shift; exec "$PY" "$PROJ/scripts/qc.py" "$@" ;;
  library)  shift; exec "$PY" "$PROJ/scripts/library.py" "$@" ;;
  atlas)    shift; exec "$PROJ/scripts/atlas.sh" "$@" ;;
  apps)     shift; exec "$PROJ/scripts/apps.sh" "$@" ;;
  network)  shift; exec "$PROJ/scripts/network.sh" "$@" ;;
  harvest)  shift; exec "$PROJ/scripts/harvest.sh" "$@" ;;
  deepen)   shift; exec "$PROJ/scripts/deepen.sh" "$@" ;;
  handoff)  shift; exec "$PROJ/scripts/handoff.sh" "$@" ;;
  ingest)   shift; exec "$PROJ/scripts/ingest.sh" "$@" ;;
  watch)    shift; exec "$PROJ/scripts/watch.sh" "$@" ;;
  transcribe) shift; exec "$PROJ/scripts/transcribe.sh" "$@" ;;
  generate) shift; exec "$PROJ/scripts/generate.sh" "$@" ;;
  composite) shift; exec "$PROJ/scripts/composite.sh" "$@" ;;
  *)
    cat <<'USAGE'
ugckit — a niche or a reference video in, a recreation out.

  ugckit doctor              preflight: tools, deps, credentials, live auth
  ugckit ui [--port N]       local review UI (default http://127.0.0.1:7878)
  ugckit key                 fill in .env — it asks you for each value
  ugckit state show <proj>   pipeline progress, spend and open feedback
  ugckit state projects      list projects

  research (R0-R5), optional — costs Monid credit:
  ugckit apps <proj> "<keyword>" ...            find the apps in the niche
  ugckit network <proj> <app> "<keyword>" ...   find who really promotes one app
  ugckit network <proj> <app> --comments <url>  read a post's comments
  ugckit harvest <proj> <app> --all [maxItems]
  ugckit deepen <proj> <app> --rank | --deep | <handle>
  ugckit handoff <proj> <app> <handle> <post-id>
  ugckit library <stats|templates|hooks|formats|mechanics|teardowns>
  ugckit atlas [--index]                        explore everything scraped, at http://localhost:3210

  recreation (1-9):
  ugckit ingest <video> <proj> [start] [len]
  ugckit watch <proj>
  ugckit transcribe <proj>
  ugckit generate <proj>     (needs CONFIRM=1 — it spends money)
  ugckit qc <proj>
  ugckit composite <proj>

Most of the time you should not run these by hand. Start an agent in this
directory and let it drive:  claude   (or: codex)
It reads AGENTS.md and runs the stages in order.
USAGE
    ;;
esac
